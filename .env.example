# RiiMusic — cấu hình máy chủ. Chép thành .env rồi điền.
# Biến môi trường thật (shell, Docker, Coolify) được ưu tiên hơn file này.

# ── Cơ sở dữ liệu (PostgreSQL) ─────────────────────────────────────────
# Docker Compose: chỉ cần đặt mật khẩu (chữ và số, không ký tự đặc biệt vì nằm trong URL).
POSTGRES_USER=rii
POSTGRES_PASSWORD=doi-mat-khau-db
POSTGRES_DB=rii_music
# Chạy trực tiếp trên máy (không Docker): trỏ tới PostgreSQL của bạn.
# Docker Compose tự đặt biến này, không cần điền.
DATABASE_URL=postgres://rii:doi-mat-khau-db@localhost:5432/rii_music?sslmode=disable

# ── Admin đầu tiên ─────────────────────────────────────────────────────
# Chỉ dùng khi cơ sở dữ liệu chưa có tài khoản nào. Đổi mật khẩu sau khi đăng nhập.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=doi-mat-khau-nay

# Giới hạn dung lượng nhạc mặc định cho tài khoản mới (MB). Admin chỉnh từng người được.
DEFAULT_STORAGE_LIMIT_MB=2048

# ── Email (mã OTP đăng nhập, quên mật khẩu, thư mời) ───────────────────
# Gmail: bật xác minh 2 bước, tạo "Mật khẩu ứng dụng" tại
# https://myaccount.google.com/apppasswords rồi dán vào SMTP_PASSWORD (16 ký tự, có hay không dấu cách đều được).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ban@gmail.com
SMTP_PASSWORD=
# Mặc định = SMTP_USERNAME
SMTP_FROM=

# Địa chỉ công khai của trang (để in vào email), ví dụ https://nhac.example.com
PUBLIC_URL=

# ── Gợi ý ──────────────────────────────────────────────────────────────
# Không bắt buộc: có key thì nghệ sĩ tương tự lấy từ Last.fm, không thì Deezer.
LASTFM_API_KEY=

# ── Máy chủ ────────────────────────────────────────────────────────────
PORT=8080
# Nhạc, ảnh bìa, yt-dlp, cookies.txt (dữ liệu bảng nằm ở PostgreSQL)
DATA_DIR=./data
# true khi chạy sau reverse proxy (Coolify, Nginx) để lấy IP thật
TRUST_PROXY=false
DOWNLOAD_CONCURRENCY=2
MAX_DURATION_SEC=10800
# FFMPEG_PATH=ffmpeg
# YTDLP_PATH=
# YT_COOKIES_PATH=./data/cookies.txt
# YTDLP_GEO_COUNTRY=VN
# LOG_LEVEL=info
