{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RiiMusic",
  "version": "1.0.0",
  "identifier": "app.riimusic.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RiiMusic",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0E0F12",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "externalBin": ["binaries/rii_music"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["riimusic"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/konnn04/rii-music/releases/download/desktop-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzQ0Q0QkU2M0MwNTU5NDIKUldSQ1dRVTg1a3ZOMHd2cm5iRmZXR2EzZGNBc1ZHQzFySHhFcndnbElWeDk1aDNNbDNYOW5kUWMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
