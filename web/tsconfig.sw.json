{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "src/sw.ts",
    "src/offline/idb.ts"
  ]
}
