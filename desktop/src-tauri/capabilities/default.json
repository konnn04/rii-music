{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for RiiMusic main window and local sidecar origin",
  "windows": ["main", "mini"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "autostart:default",
    "deep-link:default",
    "dialog:default",
    "global-shortcut:default",
    "notification:default",
    "opener:default",
    "shell:default",
    "updater:default",
    "window-state:default"
  ]
}
